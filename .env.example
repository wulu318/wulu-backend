# Optional WULU image/video API proxy. The upstream must implement the /api/media/* contract.
MEDIA_SERVICE_BASE_URL=https://your-media-service.example
MEDIA_SERVICE_API_KEY=
# Optional realtime ASR session service. It must return { code: 0, data: { wsUrl, requestId, ... } }.
ASR_REALTIME_SESSION_URL=https://your-asr-service.example/realtime/sessions
ASR_REALTIME_API_KEY=
DATABASE_PATH=./data/wulu.db
CORS_ORIGIN=https://ai.005656.xyz
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=WULU <no-reply@example.com>
# Public base URL used in OAuth/browser login links (e.g. http://localhost:3001 locally)
SERVER_BASE_URL=https://ai.005656.xyz
# Web app origin allowed by CORS, e.g. http://localhost:5175 during local web development
CORS_ORIGIN=https://ai.005656.xyz
