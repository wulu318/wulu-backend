PORT=3001
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@wulu-superagent.com
ADMIN_PASSWORD=change-me
NEWAPI_BASE_URL=https://your-newapi-instance.com
